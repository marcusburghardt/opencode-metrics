{
	"name": "@mburghardt/opencode-metrics",
	"version": "0.5.2",
	"description": "OpenCode plugin for automatic session metrics collection and analytics",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marcusburghardt/opencode-metrics.git"
	},
	"type": "module",
	"files": [
		"dist/"
	],
	"main": "dist/index.js",
	"exports": {
